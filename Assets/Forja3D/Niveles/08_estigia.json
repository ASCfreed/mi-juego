      "nombre": "Filippo Argenti",
      "seguir": false,
      "dialogo": [
        {
          "quien": "Filippo",
          "texto": "¿Quién eres tú, que vienes antes de tu hora?"
        },
        {
          "quien": "Dante",
          "texto": "Si vengo, no me quedo. Pero ¿quién eres tú, que te has vuelto tan sucio?"
        },
        {
          "quien": "Filippo",
          "texto": "Ya ves que soy uno que llora."
        },
        {
          "quien": "Dante",
          "texto": "Con llanto y con luto, espíritu maldito, quédate. Que te conozco, aunque estés todo sucio."
        },
        {
          "quien": "Virgilio",
          "texto": "¡Vete allá con los otros perros!"
        },
        {
          "quien": "Virgilio",
          "texto": "Alma desdeñosa, bendita la que te llevó en su vientre."
        },
        {
          "quien": "",
          "texto": "«¡A Filippo Argenti!», gritaban todos; y el florentino, espíritu rabioso, se volvía contra sí mismo con los dientes."
        }
      ],
